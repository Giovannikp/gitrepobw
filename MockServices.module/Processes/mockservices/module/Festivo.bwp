                                <bpws:sources>
                                    <bpws:source linkName="OnMessageStartToThrow">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$get/parameters/tns:api-v3-PublicHolidaysGetParameters/tns:countryCode = 'FR'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
