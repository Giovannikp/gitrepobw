                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://xmlns.example.com/20261019105929PLT&quot; xmlns:tns1=&quot;http://tns.tibco.com/bw/REST&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:messageBody>&#xa;            &lt;xsl:value-of select=&quot;'[{&amp;quot;date&amp;quot;:&amp;quot;2026-12-08&amp;quot;,&amp;quot;localName&amp;quot;:&amp;quot;Immacolata Concezione&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Immaculate Conception&amp;quot;,&amp;quot;countryCode&amp;quot;:&amp;quot;IT&amp;quot;,&amp;quot;global&amp;quot;:true,&amp;quot;types&amp;quot;:[&amp;quot;Public&amp;quot;]},{&amp;quot;date&amp;quot;:&amp;quot;2026-12-25&amp;quot;,&amp;quot;localName&amp;quot;:&amp;quot;Natale&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Christmas Day&amp;quot;,&amp;quot;countryCode&amp;quot;:&amp;quot;IT&amp;quot;,&amp;quot;global&amp;quot;:true,&amp;quot;types&amp;quot;:[&amp;quot;Public&amp;quot;]},{&amp;quot;date&amp;quot;:&amp;quot;2026-12-26&amp;quot;,&amp;quot;localName&amp;quot;:&amp;quot;Santo Stefano&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;St Stephens Day&amp;quot;,&amp;quot;countryCode&amp;quot;:&amp;quot;IT&amp;quot;,&amp;quot;global&amp;quot;:true,&amp;quot;types&amp;quot;:[&amp;quot;Public&amp;quot;]}]'&quot;/>&#xa;        &lt;/tns1:messageBody>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://xmlns.example.com/20261019105929PLT" xmlns:tns1="http://tns.tibco.com/bw/REST" version="2.0"&gt;&lt;xsl:template name="getOut-input" match="/"&gt;&lt;tns:getResponse&gt;&lt;message&gt;&lt;tns1:messageBody&gt;&lt;xsl:value-of select="'[{&amp;quot;date&amp;quot;:&amp;quot;2026-12-08&amp;quot;,&amp;quot;localName&amp;quot;:&amp;quot;Immacolata Concezione&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Immaculate Conception&amp;quot;,&amp;quot;countryCode&amp;quot;:&amp;quot;IT&amp;quot;,&amp;quot;global&amp;quot;:true,&amp;quot;types&amp;quot;:[&amp;quot;Public&amp;quot;]},{&amp;quot;date&amp;quot;:&amp;quot;2026-12-25&amp;quot;,&amp;quot;localName&amp;quot;:&amp;quot;Natale&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;Christmas Day&amp;quot;,&amp;quot;countryCode&amp;quot;:&amp;quot;IT&amp;quot;,&amp;quot;global&amp;quot;:true,&amp;quot;types&amp;quot;:[&amp;quot;Public&amp;quot;]},{&amp;quot;date&amp;quot;:&amp;quot;2026-12-26&amp;quot;,&amp;quot;localName&amp;quot;:&amp;quot;Santo Stefano&amp;quot;,&amp;quot;name&amp;quot;:&amp;quot;St Stephens Day&amp;quot;,&amp;quot;countryCode&amp;quot;:&amp;quot;IT&amp;quot;,&amp;quot;global&amp;quot;:true,&amp;quot;types&amp;quot;:[&amp;quot;Public&amp;quot;]}]'"/&gt;&lt;/tns1:messageBody&gt;&lt;/message&gt;&lt;/tns:getResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <bpws:targets>
                                    <bpws:target linkName="OnMessageStartTogetOut"/>
                                    <bpws:target linkName="SleepEsTogetOut"/>
                                </bpws:targets>
