                                    <tibex:expression
                                    expression="$get/parameters/tns:api-v3-PublicHolidaysGetParameters/tns:countryCode = 'ES'" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$get.parameters/tns:countryCode = 'ES']]></bpws:transitionCondition>
                                    </bpws:source>
