            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="tns:orders"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.example.org/OrderRequestSchema"/>
            <wsdl:import namespace="http://www.example.org/OrderResponseSchema"/>
            <wsdl:import namespace="http://tns.tibco.com/bw/REST"/>
            <wsdl:import namespace="http://www.example.org/ErrorSchema"/>
            <wsdl:import namespace="http://xmlns.example.com/Orders/parameters"/>
            <wsdl:import namespace="http://xmlns.example.com/Orders/headerParameters"/>
            <wsdl:message name="postRequest">
                <wsdl:part element="extns:orderRequest" name="item" tibex:hasMultipleNamespaces="false"/>
                <wsdl:part element="extns5:ordersPostHeader"
                    name="httpHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:message name="postResponse">
                <wsdl:part element="extns1:orderResponse" name="item" tibex:hasMultipleNamespaces="false"/>
                <wsdl:part element="extns5:ordersPostResponseHeader"
                    name="httpResponseHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:message name="post4XXFaultMessage">
                <wsdl:part element="extns2:client4XXError" name="clientError"/>
                <wsdl:part element="extns5:ordersPostResponseHeader"
                    name="httpFaultHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:message name="post5XXFaultMessage">
                <wsdl:part element="extns2:server5XXError" name="serverError"/>
                <wsdl:part element="extns5:ordersPostResponseHeader"
                    name="httpFaultHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:message name="post400FaultMessage">
                <wsdl:part element="extns3:errorResponse"
                    name="client-400-ValidationError"
                    tibex:reasonPhrase="Validation Error" tibex:statusCode="400"/>
                <wsdl:part element="extns5:ordersPostResponseHeader"
                    name="httpFaultHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:message name="post400FaultMessage1">
                <wsdl:part name="client-400-OK" tibex:reasonPhrase="OK"
                    tibex:statusCode="400" type="xsd:string"/>
            </wsdl:message>
            <wsdl:message name="post502FaultMessage">
                <wsdl:part element="extns3:errorResponse"
                    name="server-502-UPSTREAM_FX_UNAVAILABLE"
                    tibex:reasonPhrase="UPSTREAM_FX_UNAVAILABLE" tibex:statusCode="502"/>
                <wsdl:part element="extns5:ordersPostResponseHeader"
                    name="httpFaultHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:portType name="orders" tibex:bw.rest.apipath="/orders"
                tibex:bw.rest.basepath="Orders"
                tibex:bw.rest.resource="Service Descriptors/orderenrichment.module.Main_Orders-Orders.json"
                tibex:bw.rest.resource.source="generated" tibex:source="bw.rest.service">
                <wsdl:documentation>Orders service</wsdl:documentation>
                <wsdl:operation name="post">
                    <wsdl:documentation>postOrders</wsdl:documentation>
                    <wsdl:input message="tns:postRequest" name="postInput"/>
                    <wsdl:output message="tns:postResponse" name="postOutput"/>
                    <wsdl:fault message="tns:post4XXFaultMessage" name="clientFault"/>
                    <wsdl:fault message="tns:post5XXFaultMessage" name="serverFault"/>
                    <wsdl:fault message="tns:post400FaultMessage" name="client-400-Fault"/>
                    <wsdl:fault message="tns:post400FaultMessage1" name="client-400-Fault1"/>
                    <wsdl:fault message="tns:post502FaultMessage" name="server-502-Fault"/>
                </wsdl:operation>
            </wsdl:portType>
        </wsdl:definitions>
    </tibex:Types>
