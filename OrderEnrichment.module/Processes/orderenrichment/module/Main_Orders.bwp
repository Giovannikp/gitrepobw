of select=&quot;$Call_DeliveryDate/tns7:effectiveDeliveryDate&quot;/>&#xa;            &lt;/tns6:effectiveDeliveryDate>&#xa;            &lt;tns6:deliveryShiftReason>&#xa;                &lt;xsl:value-of select=&quot;$Call_DeliveryDate/tns7:deliveryShiftReason&quot;/>&#xa;            &lt;/tns6:deliveryShiftReason>&#xa;        &lt;/tns6:orderResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
