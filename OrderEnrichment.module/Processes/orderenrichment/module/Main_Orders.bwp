                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/namespaces/tnt/plugins/generalactivities/mapper/1791448757653&quot; xmlns:tns2=&quot;http://www.example.org/OrderRequestSchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns9=&quot;http://xmlns.example.com/Orders/headerParameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post&quot;/>&#xa;    &lt;xsl:param name=&quot;_processContext&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns1:MapperInput>&#xa;            &lt;isValid>&#xa;                &lt;xsl:value-of select=&quot;boolean(string-length($post/item/tns2:orderRequest/tns2:orderId) > 0&amp;#xD;&amp;#xA;and matches($post/item/tns2:orderRequest/tns2:countryCode, '^[A-Z]{2}$')&amp;#xD;&amp;#xA;and matches($post/item/tns2:orderRequest/tns2:currency, '^[A-Z]{3}$')&amp;#xD;&amp;#xA;and matches($post/item/tns2:orderRequest/tns2:requestedDeliveryDate, '^[0-9]{4}-[0-9]{2}-[0-9]{2}$')&amp;#xD;&amp;#xA;and count($post/item/tns2:orderRequest/tns2:items/tns2:item) >= 1&amp;#xD;&amp;#xA;and count($post/item/tns2:orderRequest/tns2:items/tns2:item[not(number(tns2:qty) > 0)]) = 0&amp;#xD;&amp;#xA;and count($post/item/tns2:orderRequest/tns2:items/tns2:item[not(number(tns2:unitPrice) >= 0)]) = 0)&quot;/>&#xa;            &lt;/isValid>&#xa;            &lt;errorField>&#xa;                &lt;xsl:value-of select=&quot;if (string-length($post/item/tns2:orderRequest/tns2:orderId) = 0) then 'orderId'&amp;#xD;&amp;#xA;else if (not(matches($post/item/tns2:orderRequest/tns2:countryCode, '^[A-Z]{2}$'))) then 'countryCode'&amp;#xD;&amp;#xA;else if (not(matches($post/item/tns2:orderRequest/tns2:currency, '^[A-Z]{3}$'))) then 'currency'&amp;#xD;&amp;#xA;else if (not(matches($post/item/tns2:orderRequest/tns2:requestedDeliveryDate, '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) then 'requestedDeliveryDate'&amp;#xD;&amp;#xA;else if (count($post/item/tns2:orderRequest/tns2:items/tns2:item[not(number(tns2:qty) > 0)]) > 0) then 'qty' else if (count($post/item/tns2:orderRequest/tns2:items/tns2:item) = 0) then 'items'&amp;#xD;&amp;#xA;else ' '&quot;/>&#xa;            &lt;/errorField>&#xa;            &lt;errorIssue>&#xa;                &lt;xsl:value-of select=&quot;if (string-length($post/item/tns2:orderRequest/tns2:orderId) = 0) then 'è obbligatorio'&amp;#xD;&amp;#xA;else if (not(matches($post/item/tns2:orderRequest/tns2:countryCode, '^[A-Z]{2}$'))) then 'deve essere di 2 lettere maiuscole'&amp;#xD;&amp;#xA;else if (not(matches($post/item/tns2:orderRequest/tns2:currency, '^[A-Z]{3}$'))) then 'deve essere di 3 lettere maiuscole'&amp;#xD;&amp;#xA;else if (not(matches($post/item/tns2:orderRequest/tns2:requestedDeliveryDate, '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) then 'deve essere nel formato AAAA-MM-GG'&amp;#xD;&amp;#xA;else if (count($post/item/tns2:orderRequest/tns2:items/tns2:item) = 0) then 'deve contenere almeno un item'&amp;#xD;&amp;#xA;else if (count($post/item/tns2:orderRequest/tns2:items/tns2:item[not(number(tns2:qty) > 0)]) > 0) then 'deve essere > 0'&amp;#xD;&amp;#xA;else if (count($post/item/tns2:orderRequest/tns2:items/tns2:item[not(number(tns2:unitPrice) >= 0)]) > 0) then 'deve essere >= 0'&amp;#xD;&amp;#xA;else ' '&quot;/>&#xa;            &lt;/errorIssue>&#xa;            &lt;correlationId>&#xa;                &lt;xsl:value-of select=&quot;if (string-length($post/httpHeaders/tns9:ordersPostHeader/X-Correlation-Id) > 0) then $post/httpHeaders/tns9:ordersPostHeader/X-Correlation-Id else concat('REQ-', $_processContext/JobId, '-', replace(string(current-dateTime()), '[^0-9]', ''))&quot;/>&#xa;            &lt;/correlationId>&#xa;        &lt;/tns1:MapperInput>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
                                    inputVariable="Mapper-input"
                                    name="Mapper"
                                    outputVariable="Mapper"
                                    tibex:xpdlId="3988ac34-1023-40cc-b30c-66b08029bbd9" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="OnMessageStartToMapper"/>
                                    </bpws:targets>
                                    <bpws:sources>
