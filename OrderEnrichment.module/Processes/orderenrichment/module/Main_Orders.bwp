        <task name="pick">
            <endingVariables>
                <variable>Mapper</variable>
            </endingVariables>
        </task>
        <task name="flow1">
            <endingVariables>
                <variable>post</variable>
                <variable>Call_FxRate</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
                <variable>MapperResponce</variable>
            </endingVariables>
        </task>
        <task name="Mapper">
