                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://xmlns.example.com/20261008100054PLT&quot; xmlns:tns3=&quot;http://www.example.org/ErrorSchema&quot; xmlns:tns9=&quot;http://xmlns.example.com/Orders/headerParameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;MapperErrorResponse&quot;/>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;PostOut_Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns3:errorResponse>&#xa;            &lt;tns3:code>&#xa;                &lt;xsl:value-of select=&quot;$MapperErrorResponse/tns3:code&quot;/>&#xa;            &lt;/tns3:code>&#xa;            &lt;tns3:message>&#xa;                &lt;xsl:value-of select=&quot;$MapperErrorResponse/tns3:message&quot;/>&#xa;            &lt;/tns3:message>&#xa;            &lt;tns3:correlationId>&#xa;                &lt;xsl:value-of select=&quot;$Mapper/correlationId&quot;/>&#xa;            &lt;/tns3:correlationId>&#xa;            &lt;tns3:details>&#xa;                &lt;xsl:copy-of select=&quot;$MapperErrorResponse/tns3:details/tns3:detail&quot;/>&#xa;            &lt;/tns3:details>&#xa;        &lt;/tns3:errorResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://xmlns.example.com/20261008100054PLT&quot; xmlns:tns3=&quot;http://www.example.org/ErrorSchema&quot; xmlns:tns9=&quot;http://xmlns.example.com/Orders/headerParameters&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Mapper&quot;/>&#xa;    &lt;xsl:template name=&quot;PostOut_Error-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns9:ordersPostResponseHeader>&#xa;            &lt;X-Correlation-Id>&#xa;                &lt;xsl:value-of select=&quot;$Mapper/correlationId&quot;/>&#xa;            &lt;/X-Correlation-Id>&#xa;        &lt;/tns9:ordersPostResponseHeader>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
