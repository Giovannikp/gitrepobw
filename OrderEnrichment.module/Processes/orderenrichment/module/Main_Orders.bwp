&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://xmlns.example.com/20261008100054PLT" xmlns:tns9="http://xmlns.example.com/Orders/headerParameters" version="2.0"&gt;&lt;xsl:param name="Mapper500"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:template name="PostOut_Internal-input" match="/"&gt;&lt;tns4:post500FaultMessage&gt;&lt;server-500-InternalError&gt;&lt;xsl:copy-of select="$Mapper500"/&gt;&lt;/server-500-InternalError&gt;&lt;httpFaultHeaders&gt;&lt;tns9:ordersPostResponseHeader&gt;&lt;X-Correlation-Id&gt;&lt;xsl:value-of select="$Mapper/correlationId"/&gt;&lt;/X-Correlation-Id&gt;&lt;/tns9:ordersPostResponseHeader&gt;&lt;/httpFaultHeaders&gt;&lt;/tns4:post500FaultMessage&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
