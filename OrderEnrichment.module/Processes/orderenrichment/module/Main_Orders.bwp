                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns4="http://xmlns.example.com/20261008100054PLT" xmlns:tns9="http://xmlns.example.com/Orders/headerParameters" version="2.0"&gt;&lt;xsl:param name="MapperResponce"/&gt;&lt;xsl:param name="Mapper"/&gt;&lt;xsl:template name="postOut-input" match="/"&gt;&lt;tns4:postResponse&gt;&lt;item&gt;&lt;xsl:copy-of select="$MapperResponce"/&gt;&lt;/item&gt;&lt;httpResponseHeaders&gt;&lt;tns9:ordersPostResponseHeader&gt;&lt;X-Correlation-Id&gt;&lt;xsl:value-of select="$Mapper/correlationId"/&gt;&lt;/X-Correlation-Id&gt;&lt;/tns9:ordersPostResponseHeader&gt;&lt;/httpResponseHeaders&gt;&lt;/tns4:postResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
