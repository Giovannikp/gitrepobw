        <task name="PostOut_UpstreamFx">
            <endingVariables>
                <variable>PostOut_UpstreamFx-input</variable>
                <variable>MapperUpstreamFx</variable>
            </endingVariables>
        </task>
        <task name="LogError">
            <endingVariables>
                <variable>LogError-input</variable>
            </endingVariables>
        </task>
        <task name="Mapper500">
            <endingVariables>
                <variable>Mapper500-input</variable>
            </endingVariables>
        </task>
        <task name="PostOut_Internal">
            <endingVariables>
                <variable>PostOut_Internal-input</variable>
                <variable>Mapper500</variable>
            </endingVariables>
