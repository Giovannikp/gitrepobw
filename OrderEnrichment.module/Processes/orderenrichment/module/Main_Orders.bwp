                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns6=&quot;http://www.example.org/OrderResponseSchema&quot; xmlns:tns2=&quot;http://www.example.org/OrderRequestSchema&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns12=&quot;http://www.example.com/namespaces/tns/1792757890187&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;post.item&quot;/>&#xa;    &lt;xsl:param name=&quot;Call_Enrichment&quot;/>&#xa;    &lt;xsl:template name=&quot;MapperResponse-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns6:orderResponse>&#xa;            &lt;tns6:orderId>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns2:orderId&quot;/>&#xa;            &lt;/tns6:orderId>&#xa;            &lt;tns6:currency>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns2:currency&quot;/>&#xa;            &lt;/tns6:currency>&#xa;            &lt;tns6:totalAmount>&#xa;                &lt;xsl:value-of select=&quot;round(sum(for $x in $post.item/tns2:items/tns2:item return $x/tns2:qty * $x/tns2:unitPrice) * 100) div 100&quot;/>&#xa;            &lt;/tns6:totalAmount>&#xa;            &lt;tns6:fxRate>&#xa;                &lt;xsl:value-of select=&quot;$Call_Enrichment/tns12:fxRate&quot;/>&#xa;            &lt;/tns6:fxRate>&#xa;            &lt;tns6:totalEUR>&#xa;                &lt;xsl:value-of select=&quot;round(sum(for $x in $post.item/tns2:items/tns2:item return $x/tns2:qty * $x/tns2:unitPrice) * ($Call_Enrichment/tns12:fxRate) * 100) div 100&quot;/>&#xa;            &lt;/tns6:totalEUR>&#xa;            &lt;tns6:requestedDeliveryDate>&#xa;                &lt;xsl:value-of select=&quot;$post.item/tns2:requestedDeliveryDate&quot;/>&#xa;            &lt;/tns6:requestedDeliveryDate>&#xa;            &lt;tns6:effectiveDeliveryDate>&#xa;                &lt;xsl:value-of select=&quot;$Call_Enrichment/tns12:effecti