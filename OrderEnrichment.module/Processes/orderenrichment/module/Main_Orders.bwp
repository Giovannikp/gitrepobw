    <tibex:VariableDescriptor type="MemorySaving">
        <task name="pick">
            <endingVariables>
                <variable>post</variable>
                <variable>Mapper</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
                <variable>MapperResponse</variable>
            </endingVariables>
        </task>
        <task name="Mapper">
            <endingVariables>
                <variable>Mapper-input</variable>
            </endingVariables>
        </task>
        <task name="MapperErrorResponse">
            <endingVariables>
                <variable>MapperErrorResponse-input</variable>
            </endingVariables>
        </task>
        <task name="PostOut_Error">
            <endingVariables>
                <variable>PostOut_Error-input</variable>
                <variable>MapperErrorResponse</variable>
            </endingVariables>
        </task>
        <task name="MapperResponse">
            <endingVariables>
                <variable>MapperResponse-input</variable>
                <variable>Call_Enrichment</variable>
            </endingVariables>
        </task>
        <task name="Call_Enrichment">
            <endingVariables>
                <variable>Call_Enrichment-input</variable>
            </endingVariables>
        </task>
        <task name="flow2">
            <endingVariables>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="PostOut_InvalidCurrency">
            <endingVariables>
                <variable>PostOut_InvalidCurrency-input</variable>
                <variable>MapperInvalidCurrency</variable>
            </endingVariables>
        </task>
        <task name="MapperInvalidCurrency">
            <endingVariables>
