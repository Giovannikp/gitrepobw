                                    xmlns:mapper_1791448757653="http://www.tibco.com/namespaces/tnt/plugins/generalactivities/mapper/1791448757653" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
