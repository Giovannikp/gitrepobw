                            <bpws:reply faultName="client-400-Fault"
                                name="PostOut_Error" operation="post"
                                partnerLink="orders"
                                portType="ns:orders"
                                tibex:xpdlId="91c837c8-3a53-4ee5-8332-23784ce42c01" variable="PostOut_Error-input">
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
