                                    name="MapperErrorResponse"
                                    outputVariable="MapperErrorResponse"
                                    tibex:xpdlId="c00f9539-88a8-4e50-87b2-c1ea018ee444" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
