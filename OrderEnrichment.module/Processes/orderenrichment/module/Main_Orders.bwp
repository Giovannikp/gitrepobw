                        name="loggerName" type="xs:string"/>
                    <xs:element form="unqualified" minOccurs="0"
                        name="logLevel" type="xs:string"/>
                    <xs:element form="unqualified" name="message" type="xs:string"/>
                </xs:sequence>
            </xs:complexType>
            <xs:element name="ActivityInput" type="tns:LogParametersType"/>
        </xs:schema>
        <wsdl:definitions
            targetNamespace="http://xmlns.example.com/20261008100054PLT"
            xmlns:extns="http://www.example.org/OrderRequestSchema"
            xmlns:extns1="http://www.example.org/OrderResponseSchema"
            xmlns:extns2="http://tns.tibco.com/bw/REST"
            xmlns:extns3="http://www.example.org/ErrorSchema"
