            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="b8536fc8-e2d5-4822-bed5-a963058adf3f"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToSendHTTPRequest"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="86427cb8-b7b1-4c7d-ae7e-db61eee797f3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1791450262275&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1791449715314&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;MapperFestivo&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:root>&lt;tns:effectiveDeliveryDate>&lt;xsl:value-of select=&quot;string((for $i in 0 to 30&amp;#xD;&amp;#xA; return if (not(((((xsd:date($Start/tns1:requestedDeliveryDate) + xsd:dayTimeDuration(concat('P', string($i), 'D'))) - xsd:date('1900-01-07')) div xsd:dayTimeDuration('P1D')) mod 7) = (0, 6))&amp;#xD;&amp;#xA;            and not(string((xsd:date($Start/tns1:requestedDeliveryDate) + xsd:dayTimeDuration(concat('P', string($i), 'D')))) = tokenize($MapperFestivo, ',')))&amp;#xD;&amp;#xA;        then (xsd:date($Start/tns1:requestedDeliveryDate) + xsd:dayTimeDuration(concat('P', string($i), 'D'))) else ())[1])&quot;/>&lt;/tns:effectiveDeliveryDate>&lt;tns:deliveryShiftReason>&lt;xsl:value-of select=&quot;if ($Start/tns1:requestedDeliveryDate = tokenize($MapperFestivo, ',')) then 'HOLIDAY'&amp;#xD;&amp;#xA;else if (((xsd:date($Start/tns1:requestedDeliveryDate) - xsd:date('1900-01-07')) div xsd:dayTimeDuration('P1D')) mod 7 = (0, 6)) then 'WEEKEND'&amp;#xD;&amp;#xA;else 'NONE'&quot;/>&lt;/tns:deliveryShiftReason>&lt;/tns:root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
