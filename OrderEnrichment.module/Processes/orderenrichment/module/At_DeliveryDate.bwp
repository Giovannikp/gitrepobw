                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Call_GetHolidaysNextYearToMapper2"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns8=&quot;http://www.example.com/namespaces/tns/1792416103416&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1791449715314&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Call_GetHolidaysNextYear-input&quot; match=&quot;/&quot;>&lt;tns8:root>&lt;tns8:countryCode>&lt;xsl:value-of select=&quot;$Start/tns1:countryCode&quot;/>&lt;/tns8:countryCode>&lt;tns8:year>&lt;xsl:value-of select=&quot;string(xsd:int(substring($Start/tns1:requestedDeliveryDate, 1, 4)) + 1)&quot;/>&lt;/tns8:year>&lt;tns8:correlationId>&lt;xsl:value-of select=&quot;$Start/tns1:correlationId&quot;/>&lt;/tns8:correlationId>&lt;/tns8:root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="orderenrichment.module.GetHolidays" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Mapper2-input"
                    name="Mapper2" outputVariable="Mapper2"
                    tibex:xpdlId="13210f9c-6241-4ab7-86c1-b0351a04cbb7" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Call_GetHolidaysNextYearToMapper2"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Mapper2ToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.example.com/namespaces/tns/1792485468889&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1791449715314&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns9=&quot;http://www.example.com/namespaces/tns/1792679953386&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Call_GetHolidays&quot;/>&#xa;    &lt;xsl:param name=&quot;Call_GetHolidaysNextYear&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper2-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:campo>&#xa;            &lt;xsl:value-of select=&quot;string((for $i in 0 to &amp;#xD;&amp;#xA;30&amp;#xD;&amp;#xA;return if (not(((((xsd:date($Start/tns1:requestedDeliveryDate) + xsd:dayTimeDuration(concat('P', string($i), 'D'))) - xsd:date('1900-01-07')) div xsd:dayTimeDuration('P1D')) mod 7) = (0, 6))&amp;#xD;&amp;#xA;and not(string((xsd:date($Start/tns1:requestedDeliveryDate) + xsd:dayTimeDuration(concat('P', string($i), 'D')))) = tokenize(concat(   $Call_GetHolidays/tns9:dates, ',', $Call_GetHolidaysNextYear/tns9:dates), ',')))&amp;#xD;&amp;#xA;then (xsd:date($Start/tns1:requestedDeliveryDate) + xsd:dayTimeDuration(concat('P', string($i), 'D'))) else ())[1])&quot;/>&#xa;        &lt;/tns7:campo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:tns_1792485468889="http://www.example.com/namespaces/tns/1792485468889" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="tns_1792485468889:campo" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogStartDelivery-input"
                    name="LogStartDelivery"
                    tibex:xpdlId="83924d39-4878-4a04-8156-f868e40d3b32" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
