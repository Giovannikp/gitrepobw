    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToCallProcess" tibex:linkType="SUCCESS"/>
                <bpws:link name="Call_GetHolidaysToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperToEnd" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="MapperToCallProcess" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="Call_GetHolidaysNextYearToMapper2" tibex:linkType="SUCCESS"/>
                <bpws:link name="Mapper2ToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link name="LogToCall_GetHolidays" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="b8536fc8-e2d5-4822-bed5-a963058adf3f"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToCallProcess"/>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="86427cb8-b7b1-4c7d-ae7e-db61eee797f3" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToEnd"/>
                        <bpws:target linkName="Mapper2ToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.example.com/namespaces/tns/1791450262275&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1791449715314&quot; xmlns:tns9=&quot;http://www.example.com/namespaces/tns/1792679953386&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:param name=&quot;Mapper1&quot;/>&lt;xsl:param name=&quot;Mapper2&quot;/>&lt;xsl:param name=&quot;Call_GetHolidays&quot;/>&lt;xsl:param name=&quot;Call_GetHolidaysNextYear&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:root>&lt;tns:effectiveDeliveryDate>&lt;xsl:value-of select=&quot;if (substring($Mapper1, 1, 4) !=substring($Start/tns1:requestedDeliveryDate, 1, 4)) then $Mapper2 else $Mapper1&quot;/>&lt;/tns:effectiveDeliveryDate>&lt;tns:deliveryShiftReason>&lt;xsl:value-of select=&quot;if ($Start/tns1:requestedDeliveryDate = tokenize($Call_GetHolidays/tns9:dates, ',')) then 'HOLIDAY'&amp;#xD;&amp;#xA;else if (((xsd:date($Start/tns1:requestedDeliveryDate) - xsd:date('1900-01-07')) div xsd:dayTimeDuration('P1D')) mod 7 = (0, 6)) then 'WEEKEND'&amp;#xD;&amp;#xA;else 'NONE'&quot;/>&lt;/tns:deliveryShiftReason>&lt;tns:warnings>&lt;xsl:value-of select=&quot;if ($Call_GetHolidays/tns9:skipped = true() or (if (substring($Mapper1, 1, 4) != substring($Start/tns1:requestedDeliveryDate, 1, 4)) then $Call_GetHolidaysNextYear/tns9:skipped = true() else false())) then 'HOLIDAY_CHECK_SKIPPED' else ()&quot;/>&lt;/tns:warnings>&lt;/tns:root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="Call_GetHolidays-input"
                    name="Call_GetHolidays"
                    outputVariable="Call_GetHolidays"
                    tibex:xpdlId="a81e9daa-e7f0-4a52-b5ee-0bc1f47bad02"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogToCall_GetHolidays"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="Call_GetHolidaysToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1791449715314&quot; xmlns:tns8=&quot;http://www.example.com/namespaces/tns/1792416103416&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;Call_GetHolidays-input&quot; match=&quot;/&quot;>&lt;tns8:root>&lt;tns8:countryCode>&lt;xsl:value-of select=&quot;$Start/tns1:countryCode&quot;/>&lt;/tns8:countryCode>&lt;tns8:year>&lt;xsl:value-of select=&quot;substring($Start/tns1:requestedDeliveryDate, 1, 4)&quot;/>&lt;/tns8:year>&lt;tns8:correlationId>&lt;xsl:value-of select=&quot;$Start/tns1:correlationId&quot;/>&lt;/tns8:correlationId>&lt;/tns8:root>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="orderenrichment.module.GetHolidays" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="Mapper1-input"
                    name="Mapper1" outputVariable="Mapper1"
                    tibex:xpdlId="6687112e-a5b2-4718-a6fe-49fb2d57010a" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="Call_GetHolidaysToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToEnd">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="MapperToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="substring($Mapper1, 1, 4) != substring($Start/ns0:requestedDeliveryDate, 1, 4)" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[substring($Mapper1, 1, 4) != substring($Start/ns0:requestedDeliveryDate, 1, 4)]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns7=&quot;http://www.example.com/namespaces/tns/1792485468889&quot; xmlns:tns1=&quot;http://www.example.com/namespaces/tns/1791449715314&quot; xmlns:xsd=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:tns9=&quot;http://www.example.com/namespaces/tns/1792679953386&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;Call_GetHolidays&quot;/>&#xa;    &lt;xsl:param name=&quot;Start&quot;/>&#xa;    &lt;xsl:template name=&quot;Mapper1-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns7:campo>&#xa;            &lt;xsl:value-of select=&quot;string((for $i in 0 to &amp;#xD;&amp;#xA;30&amp;#xD;&amp;#xA;return if (not(((((xsd:date($Start/tns1:requestedDeliveryDate) + xsd:dayTimeDuration(concat('P', string($i), 'D'))) - xsd:date('1900-01-07')) div xsd:dayTimeDuration('P1D')) mod 7) = (0, 6))&amp;#xD;&amp;#xA;and not(string((xsd:date($Start/tns1:requestedDeliveryDate) + xsd:dayTimeDuration(concat('P', string($i), 'D')))) = tokenize($Call_GetHolidays/tns9:dates, ',')))&amp;#xD;&amp;#xA;then (xsd:date($Start/tns1:requestedDeliveryDate) + xsd:dayTimeDuration(concat('P', string($i), 'D'))) else ())[1])&quot;/>&#xa;        &lt;/tns7:campo>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities"
                            xmlns:tns_1792485468889="http://www.example.com/namespaces/tns/1792485468889" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="tns_1792485468889:campo" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="Call_GetHolidaysNextYear-input"
                    name="Call_GetHolidaysNextYear"
                    outputVariable="Call_GetHolidaysNextYear"
                    tibex:xpdlId="66528c4d-3fe7-4735-b338-99dd244fab33"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
